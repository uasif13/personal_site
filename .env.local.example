# Neon Postgres connection string (Vercel Storage tab → Neon, or neon.tech directly)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for logging into /cp/login to log attempts and add problems
CP_ADMIN_PASSWORD="choose-a-password"

# Random secret used to sign the login session cookie — generate with:
# openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Powers the job tracker's description analysis and resume scoring at /jobs.
# Get one at https://console.anthropic.com/settings/keys — without it the rest of
# the tracker still works, only the two analysis buttons return an error.
ANTHROPIC_API_KEY="sk-ant-..."
